# Waitlist storage. Provision a Redis (Upstash) database from the Vercel
# Marketplace, link it to this project, and Vercel will inject KV_REST_API_URL
# and KV_REST_API_TOKEN automatically. Locally, copy this file to .env.local
# and paste in the same values from the Vercel dashboard.
#
# If both are unset the API falls back to an in-memory store. This is fine for
# `pnpm dev` but resets on every server restart. Never deploy without these.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Alternative env names accepted by the lib (use one pair or the other,
# not both). Some Upstash integrations expose these names instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Public starting offset for the waitlist position. Cosmetic. Defaults to 1247
# so position #1 reads as #1248. Bump this if you want a higher floor at launch.
# WAITLIST_PUBLIC_OFFSET=1247
